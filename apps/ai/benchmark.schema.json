{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "generated_at", "corpus_version", "corpus_sha256", "protocol", "protocol_sha256", "data_class", "real_world_performance", "external_gates_satisfied", "provider_leg", "adversarial_classes", "selections"],
  "properties": {
    "schema_version": {"const": 1},
    "generated_at": {"type": "string", "minLength": 1},
    "corpus_version": {"const": "engineering-v1"},
    "corpus_sha256": {"$ref": "#/$defs/hash"},
    "protocol": {"type": "object", "required": ["version", "corpus", "jurisdiction", "ranking", "latency_quantile", "retries", "clinical_review", "eligibility"]},
    "protocol_sha256": {"$ref": "#/$defs/hash"},
    "data_class": {"const": "synthetic"},
    "real_world_performance": {"const": false},
    "external_gates_satisfied": {"const": []},
    "provider_leg": {"const": "BLOCKED-ON-EG"},
    "adversarial_classes": {"type": "array", "minItems": 12, "uniqueItems": true, "items": {"type": "string"}},
    "selections": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/selection"}}
  },
  "$defs": {
    "hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "fact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["value", "verification", "source", "retrieved"],
      "properties": {
        "value": {"type": "string"},
        "verification": {"enum": ["verified", "unverified"]},
        "source": {"type": "string"},
        "retrieved": {"type": "string"}
      }
    },
    "candidate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "adapter", "model", "jurisdiction", "region", "retention", "price"],
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "adapter": {"enum": ["synthetic", "recorded_fixture"]},
        "model": {"type": "string", "minLength": 1},
        "jurisdiction": {"type": "string"},
        "region": {"$ref": "#/$defs/fact"},
        "retention": {"$ref": "#/$defs/fact"},
        "price": {
          "type": "object",
          "additionalProperties": false,
          "required": ["input_micros", "output_micros", "cached_micros", "audio_micros"],
          "properties": {
            "input_micros": {"type": "integer", "minimum": 0},
            "output_micros": {"type": "integer", "minimum": 0},
            "cached_micros": {"type": "integer", "minimum": 0},
            "audio_micros": {"type": "integer", "minimum": 0}
          }
        }
      }
    },
    "selection": {
      "type": "object",
      "additionalProperties": false,
      "required": ["purpose", "primary", "fallback", "candidates"],
      "properties": {
        "purpose": {"enum": ["scribe_asr", "scribe_draft", "brief", "extraction", "front_desk", "analyst", "decision_support"]},
        "primary": {"type": ["string", "null"]},
        "fallback": {"type": ["string", "null"]},
        "candidates": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/result"}}
      }
    },
    "result": {
      "type": "object",
      "additionalProperties": false,
      "required": ["candidate", "eligible", "reasons", "samples", "encounters", "wer", "structured_output", "clinical_error_rates", "clinical_review_status", "latency_ms", "usage_per_visit", "cost_per_visit_micros", "failures"],
      "properties": {
        "candidate": {"$ref": "#/$defs/candidate"},
        "eligible": {"type": "boolean"},
        "reasons": {"type": "array", "items": {"enum": ["region_unverified", "retention_unverified", "jurisdiction_mismatch", "failed_calls"]}},
        "samples": {"type": "integer", "minimum": 1},
        "encounters": {"type": "integer", "minimum": 1},
        "wer": {
          "type": "object",
          "additionalProperties": false,
          "required": ["substitutions", "deletions", "insertions", "errors", "reference_words", "rate"],
          "properties": {
            "substitutions": {"type": "integer", "minimum": 0},
            "deletions": {"type": "integer", "minimum": 0},
            "insertions": {"type": "integer", "minimum": 0},
            "errors": {"type": "integer", "minimum": 0},
            "reference_words": {"type": "integer", "minimum": 0},
            "rate": {"type": ["number", "null"], "minimum": 0}
          }
        },
        "structured_output": {
          "type": "object",
          "additionalProperties": false,
          "required": ["valid", "total", "rate"],
          "properties": {
            "valid": {"type": "integer", "minimum": 0},
            "total": {"type": "integer", "minimum": 1},
            "rate": {"type": "number", "minimum": 0, "maximum": 1}
          }
        },
        "clinical_error_rates": {
          "type": "object",
          "additionalProperties": false,
          "required": ["significant_omission", "hallucination", "speaker_attribution", "negation", "chronology", "units_decimals", "medication_name_dose", "allergy_handling"],
          "properties": {
            "significant_omission": {"type": "null"},
            "hallucination": {"type": "null"},
            "speaker_attribution": {"type": "null"},
            "negation": {"type": "null"},
            "chronology": {"type": "null"},
            "units_decimals": {"type": "null"},
            "medication_name_dose": {"type": "null"},
            "allergy_handling": {"type": "null"}
          }
        },
        "clinical_review_status": {"const": "pending_two_raters"},
        "latency_ms": {
          "type": "object",
          "additionalProperties": false,
          "required": ["p50", "p95"],
          "properties": {"p50": {"type": "number", "minimum": 0}, "p95": {"type": "number", "minimum": 0}}
        },
        "usage_per_visit": {
          "type": "object",
          "additionalProperties": false,
          "required": ["tokens_in", "tokens_out", "tokens_cached", "audio_seconds"],
          "properties": {
            "tokens_in": {"type": "number", "minimum": 0},
            "tokens_out": {"type": "number", "minimum": 0},
            "tokens_cached": {"type": "number", "minimum": 0},
            "audio_seconds": {"type": "number", "minimum": 0}
          }
        },
        "cost_per_visit_micros": {"type": "number", "minimum": 0},
        "failures": {"type": "object", "additionalProperties": false, "properties": {
          "timeout": {"type": "integer", "minimum": 1},
          "unavailable": {"type": "integer", "minimum": 1},
          "invalid_output": {"type": "integer", "minimum": 1}
        }}
      }
    }
  }
}
