{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "version", "data_class", "lawful_provenance", "capabilities", "cases"],
  "properties": {
    "schema_version": {"const": 1},
    "version": {"type": "string", "pattern": "^engineering-v[1-9][0-9]*$"},
    "data_class": {"const": "synthetic"},
    "lawful_provenance": {"type": "string", "minLength": 1, "maxLength": 500},
    "capabilities": {"type": "array", "minItems": 8, "maxItems": 8, "uniqueItems": true, "items": {"type": "string", "pattern": "^AI-0[1-8]$"}},
    "cases": {
      "type": "array", "minItems": 12, "maxItems": 1000,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["id", "encounter", "specialty", "device", "accent", "adversarial", "script", "audio_fixture"],
        "properties": {
          "id": {"type": "string", "pattern": "^synthetic-[a-z0-9-]{1,48}$"},
          "encounter": {"type": "string", "pattern": "^synthetic-encounter-[0-9]{2}$"},
          "specialty": {"enum": ["general", "pediatrics", "internal"]},
          "device": {"enum": ["synthetic-microphone", "synthetic-phone", "synthetic-headset", "synthetic-failed-microphone"]},
          "accent": {"enum": ["flite-kal", "flite-slt", "flite-rms"]},
          "adversarial": {"type": "string", "maxLength": 40},
          "script": {"type": "string", "minLength": 1, "maxLength": 2000},
          "audio_fixture": {"type": "string", "pattern": "^synthetic-[a-z0-9-]+$"}
        }
      }
    }
  }
}
