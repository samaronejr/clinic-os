{
  "edge": {
    "depends_on": [
      "web",
      "realtime"
    ],
    "image": "nginx:1.28-alpine@sha256:a8b39bd9cf0f83869a2162827a0caf6137ddf759d50a171451b335cecc87d236",
    "ports": [
      "127.0.0.1:${CLINIC_LOCAL_HTTP_PORT:-8000}:8080"
    ],
    "profiles": [
      "realtime"
    ],
    "volumes": [
      "./ops/container/realtime-nginx.conf:/etc/nginx/conf.d/default.conf:ro"
    ]
  },
  "pgbouncer": {
    "depends_on": {
      "db": {
        "condition": "service_healthy"
      }
    },
    "environment": {
      "AUTH_TYPE": "scram-sha-256",
      "DB_HOST": "db",
      "DB_NAME": "clinic",
      "DB_PASSWORD": "${CLINIC_APP_PASSWORD:-clinic_app_password}",
      "DB_USER": "clinic_app",
      "DEFAULT_POOL_SIZE": 20,
      "IGNORE_STARTUP_PARAMETERS": "options,extra_float_digits",
      "MAX_CLIENT_CONN": 1000,
      "POOL_MODE": "transaction"
    },
    "image": "edoburu/pgbouncer@sha256:4c1ca296ef525f108f5d3552cc337c0c09587cf8dae7f0067fd93349e47dc1cd",
    "profiles": [
      "realtime"
    ]
  },
  "realtime": {
    "build": {
      "context": ".",
      "target": "realtime"
    },
    "depends_on": [
      "pgbouncer",
      "redis"
    ],
    "environment": {
      "ALLOWED_HOSTS": "localhost,127.0.0.1",
      "APP_DATABASE_URL": "postgresql://clinic_app:${CLINIC_APP_PASSWORD:-clinic_app_password}@pgbouncer:5432/clinic",
      "CELERY_BROKER_URL": "redis://redis:6379/0",
      "CLINIC_DATA_MODE": "synthetic",
      "CLINIC_REALTIME_MODE": "local",
      "CLINIC_SECRET_BACKEND": "synthetic-file",
      "CLINIC_SECRET_DIR": "/run/clinic-secrets",
      "DATABASE_TRANSACTION_POOLING": "true",
      "DJANGO_SETTINGS_MODULE": "config.settings.realtime",
      "LOCKS_DATABASE_URL": "postgresql://clinic_app:${CLINIC_APP_PASSWORD:-clinic_app_password}@db:5432/clinic",
      "REALTIME_ENABLED": "true",
      "REALTIME_REDIS_URL": "redis://redis:6379/1",
      "SECRET_KEY": "${SECRET_KEY:-local-synthetic-only-change-before-use}"
    },
    "profiles": [
      "realtime"
    ],
    "volumes": [
      "${CLINIC_LOCAL_SECRET_DIR:-./.omo/local-secrets}:/run/clinic-secrets:ro"
    ]
  },
  "redis": {
    "command": [
      "redis-server",
      "--save",
      "",
      "--appendonly",
      "no"
    ],
    "image": "redis:7-alpine@sha256:858f009f9709ce576febc734aa78b8f6d624b82571f9ddb6bda4377c833b3499",
    "profiles": [
      "realtime"
    ]
  },
  "web": {
    "build": {
      "context": ".",
      "target": "web"
    },
    "depends_on": [
      "pgbouncer",
      "redis"
    ],
    "environment": {
      "ALLOWED_HOSTS": "localhost,127.0.0.1",
      "APP_DATABASE_URL": "postgresql://clinic_app:${CLINIC_APP_PASSWORD:-clinic_app_password}@pgbouncer:5432/clinic",
      "CELERY_BROKER_URL": "redis://redis:6379/0",
      "CLINIC_DATA_MODE": "synthetic",
      "CLINIC_SECRET_BACKEND": "synthetic-file",
      "CLINIC_SECRET_DIR": "/run/clinic-secrets",
      "DATABASE_TRANSACTION_POOLING": "true",
      "DJANGO_SETTINGS_MODULE": "config.settings.base",
      "LOCKS_DATABASE_URL": "postgresql://clinic_app:${CLINIC_APP_PASSWORD:-clinic_app_password}@db:5432/clinic",
      "REALTIME_ENABLED": "true",
      "REALTIME_REDIS_URL": "redis://redis:6379/1",
      "SECRET_KEY": "${SECRET_KEY:-local-synthetic-only-change-before-use}"
    },
    "profiles": [
      "realtime"
    ],
    "volumes": [
      "${CLINIC_LOCAL_SECRET_DIR:-./.omo/local-secrets}:/run/clinic-secrets:ro"
    ]
  }
}
