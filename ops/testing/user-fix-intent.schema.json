{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://clinic-os.local/schemas/user-fix-intent.schema.json",
  "$defs": {
    "uuid": {"type": "string", "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[1-5][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"},
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  },
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "attempt_id", "sha", "tree_sha", "final_sha256", "approvals_sha256", "authorized_reason"],
  "properties": {
    "schema_version": {"const": 1},
    "attempt_id": {"$ref": "#/$defs/uuid"},
    "sha": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "tree_sha": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "final_sha256": {"$ref": "#/$defs/sha256"},
    "approvals_sha256": {"$ref": "#/$defs/sha256"},
    "authorized_reason": {"const": "USER:user-requested-fix"}
  }
}
