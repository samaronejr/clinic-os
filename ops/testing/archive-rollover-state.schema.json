{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://clinic-os.local/schemas/archive-rollover-state.schema.json",
  "$defs": {
    "uuid": {"type": "string", "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[1-5][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"},
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "nullableSha256": {"oneOf": [{"$ref": "#/$defs/sha256"}, {"type": "null"}]},
    "timestamp": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{6}Z$"}
  },
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "attempt_id", "rejected_sha", "rejection_spec_sha256", "bundle_path", "stable_lock_identity_sha256", "archive_identity_sha256", "state", "control_tree_sha256", "attempt_tree_sha256", "ledger_sha256", "tombstone_sha256", "updated_at_utc"],
  "properties": {
    "schema_version": {"const": 1},
    "attempt_id": {"$ref": "#/$defs/uuid"},
    "rejected_sha": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "rejection_spec_sha256": {"$ref": "#/$defs/sha256"},
    "bundle_path": {"type": "string", "pattern": "^/[^\\u0000\\r\\n]*/\\.omo/evidence/clinic-os-phase1a-rejected/[0-9a-f-]{36}/[0-9a-f]{40}$"},
    "stable_lock_identity_sha256": {"$ref": "#/$defs/sha256"},
    "archive_identity_sha256": {"$ref": "#/$defs/sha256"},
    "state": {"enum": ["prepared", "control-moved", "attempt-moved", "ledger-moved", "tombstone-published", "relocating", "complete"]},
    "control_tree_sha256": {"$ref": "#/$defs/nullableSha256"},
    "attempt_tree_sha256": {"$ref": "#/$defs/sha256"},
    "ledger_sha256": {"$ref": "#/$defs/sha256"},
    "tombstone_sha256": {"$ref": "#/$defs/nullableSha256"},
    "updated_at_utc": {"$ref": "#/$defs/timestamp"}
  },
  "allOf": [
    {
      "if": {"properties": {"state": {"enum": ["prepared", "control-moved", "attempt-moved", "ledger-moved"]}}},
      "then": {"properties": {"tombstone_sha256": {"type": "null"}}}
    },
    {
      "if": {"properties": {"state": {"enum": ["tombstone-published", "relocating", "complete"]}}},
      "then": {"properties": {"tombstone_sha256": {"$ref": "#/$defs/sha256"}}}
    }
  ]
}
