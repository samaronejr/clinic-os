{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://clinic-os.local/schemas/rejection-spec.schema.json",
  "$defs": {
    "uuid": {"type": "string", "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[1-5][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"},
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "nullableSha256": {"oneOf": [{"$ref": "#/$defs/sha256"}, {"type": "null"}]},
    "rejection": {
      "type": "object",
      "additionalProperties": false,
      "required": ["lane", "failure_class"],
      "properties": {
        "lane": {"enum": ["F1", "F2", "F3", "F4", "ORCH", "USER"]},
        "failure_class": {"enum": ["finding", "product-failure", "infrastructure", "authentication", "session", "timeout", "malformed-output", "user-requested-fix"]}
      }
    }
  },
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "attempt_id", "sha", "retry_kind", "rejections", "failure_receipts_sha256", "user_fix_intent_sha256", "inputs_sha256", "pre_f4_sha256", "final_sha256"],
  "properties": {
    "schema_version": {"const": 1},
    "attempt_id": {"$ref": "#/$defs/uuid"},
    "sha": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "retry_kind": {"enum": ["evidence-only", "source-fix"]},
    "rejections": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/rejection"}, "uniqueItems": true},
    "failure_receipts_sha256": {"$ref": "#/$defs/nullableSha256"},
    "user_fix_intent_sha256": {"$ref": "#/$defs/nullableSha256"},
    "inputs_sha256": {"$ref": "#/$defs/nullableSha256"},
    "pre_f4_sha256": {"$ref": "#/$defs/nullableSha256"},
    "final_sha256": {"$ref": "#/$defs/nullableSha256"}
  },
  "oneOf": [
    {
      "properties": {
        "retry_kind": {"const": "evidence-only"},
        "rejections": {"items": {"properties": {"lane": {"enum": ["F1", "F2", "F3", "F4", "ORCH"]}, "failure_class": {"enum": ["infrastructure", "authentication", "session", "timeout", "malformed-output"]}}}},
        "failure_receipts_sha256": {"$ref": "#/$defs/sha256"},
        "user_fix_intent_sha256": {"type": "null"}
      }
    },
    {
      "properties": {
        "retry_kind": {"const": "source-fix"},
        "rejections": {"minItems": 1, "maxItems": 1, "items": {"properties": {"lane": {"const": "USER"}, "failure_class": {"const": "user-requested-fix"}}}},
        "failure_receipts_sha256": {"type": "null"},
        "user_fix_intent_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    {
      "properties": {
        "retry_kind": {"const": "source-fix"},
        "rejections": {
          "items": {"properties": {"lane": {"enum": ["F1", "F2", "F3", "F4", "ORCH"]}, "failure_class": {"enum": ["finding", "product-failure", "infrastructure", "authentication", "session", "timeout", "malformed-output"]}}},
          "contains": {"properties": {"failure_class": {"enum": ["finding", "product-failure"]}}}
        },
        "failure_receipts_sha256": {"$ref": "#/$defs/sha256"},
        "user_fix_intent_sha256": {"type": "null"}
      }
    }
  ]
}
