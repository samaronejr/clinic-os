{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://clinic-os.local/schemas/rejection-close.schema.json",
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "nullableSha256": {"oneOf": [{"$ref": "#/$defs/sha256"}, {"type": "null"}]},
    "nullablePath": {"type": ["string", "null"], "pattern": "^(?:user-fix-intent\\.json|user-fix-bindings/[0-9a-f-]{36}\\.json|terminal-revalidation/[0-9a-f-]{36}\\.json)$"}
  },
  "type": "object",
  "additionalProperties": false,
  "required": ["rejection_spec_sha256", "user_fix_intent_relative_path", "user_fix_intent_sha256", "user_fix_binding_relative_path", "user_fix_binding_sha256", "terminal_revalidation_relative_path", "terminal_revalidation_sha256"],
  "properties": {
    "rejection_spec_sha256": {"$ref": "#/$defs/sha256"},
    "user_fix_intent_relative_path": {"$ref": "#/$defs/nullablePath"},
    "user_fix_intent_sha256": {"$ref": "#/$defs/nullableSha256"},
    "user_fix_binding_relative_path": {"$ref": "#/$defs/nullablePath"},
    "user_fix_binding_sha256": {"$ref": "#/$defs/nullableSha256"},
    "terminal_revalidation_relative_path": {"$ref": "#/$defs/nullablePath"},
    "terminal_revalidation_sha256": {"$ref": "#/$defs/nullableSha256"}
  },
  "oneOf": [
    {
      "properties": {
        "user_fix_intent_relative_path": {"type": "null"}, "user_fix_intent_sha256": {"type": "null"},
        "user_fix_binding_relative_path": {"type": "null"}, "user_fix_binding_sha256": {"type": "null"},
        "terminal_revalidation_relative_path": {"type": "null"}, "terminal_revalidation_sha256": {"type": "null"}
      }
    },
    {
      "properties": {
        "user_fix_intent_relative_path": {"const": "user-fix-intent.json"}, "user_fix_intent_sha256": {"$ref": "#/$defs/sha256"},
        "user_fix_binding_relative_path": {"type": "string", "pattern": "^user-fix-bindings/[0-9a-f-]{36}\\.json$"}, "user_fix_binding_sha256": {"$ref": "#/$defs/sha256"},
        "terminal_revalidation_relative_path": {"type": "string", "pattern": "^terminal-revalidation/[0-9a-f-]{36}\\.json$"}, "terminal_revalidation_sha256": {"$ref": "#/$defs/sha256"}
      }
    }
  ]
}
