{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://clinic-os.invalid/schemas/accepted-final-receipt-phase1a-v1.json",
  "title": "Clinic OS Phase 1A accepted final receipt",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "approvals_sha256",
    "attempt_id",
    "closed_at_utc",
    "closed_ledger_sha256",
    "final_sha256",
    "inputs_sha256",
    "pre_f4_sha256",
    "reboot_stable_baseline_sha256",
    "schema_version",
    "sha",
    "terminal_revalidation_sha256",
    "tree_sha"
  ],
  "properties": {
    "approvals_sha256": {"$ref": "#/$defs/sha256"},
    "attempt_id": {"$ref": "#/$defs/uuid"},
    "closed_at_utc": {"$ref": "#/$defs/timestamp"},
    "closed_ledger_sha256": {"$ref": "#/$defs/sha256"},
    "final_sha256": {"$ref": "#/$defs/sha256"},
    "inputs_sha256": {"$ref": "#/$defs/sha256"},
    "pre_f4_sha256": {"$ref": "#/$defs/sha256"},
    "reboot_stable_baseline_sha256": {"$ref": "#/$defs/sha256"},
    "schema_version": {"const": 1},
    "sha": {"$ref": "#/$defs/sha40"},
    "terminal_revalidation_sha256": {"$ref": "#/$defs/sha256"},
    "tree_sha": {"$ref": "#/$defs/sha40"}
  },
  "$defs": {
    "sha40": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "timestamp": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{6}Z$"
    },
    "uuid": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[1-5][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    }
  }
}
