{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://clinic-os.local/schemas/final-wave-controller-state.schema.json",
  "$defs": {
    "uuid": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[1-5][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "nullableSha256": {
      "oneOf": [
        {
          "$ref": "#/$defs/sha256"
        },
        {
          "type": "null"
        }
      ]
    },
    "timestamp": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{6}Z$"
    },
    "nullableTimestamp": {
      "oneOf": [
        {
          "$ref": "#/$defs/timestamp"
        },
        {
          "type": "null"
        }
      ]
    },
    "leaseIdentity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "device",
        "inode",
        "mode",
        "uid",
        "gid",
        "link_count"
      ],
      "properties": {
        "device": {
          "type": "integer",
          "minimum": 0
        },
        "inode": {
          "type": "integer",
          "minimum": 1
        },
        "mode": {
          "const": 384
        },
        "uid": {
          "type": "integer",
          "minimum": 0
        },
        "gid": {
          "type": "integer",
          "minimum": 0
        },
        "link_count": {
          "const": 1
        }
      }
    },
    "controllerOwner": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sequence",
        "boot_id",
        "pid",
        "start_ticks",
        "acquired_at_utc",
        "relinquished_at_utc",
        "relinquish_kind"
      ],
      "properties": {
        "sequence": {
          "type": "integer",
          "minimum": 1
        },
        "boot_id": {
          "$ref": "#/$defs/uuid"
        },
        "pid": {
          "type": "integer",
          "minimum": 1
        },
        "start_ticks": {
          "type": "integer",
          "minimum": 1
        },
        "acquired_at_utc": {
          "$ref": "#/$defs/timestamp"
        },
        "relinquished_at_utc": {
          "$ref": "#/$defs/nullableTimestamp"
        },
        "relinquish_kind": {
          "type": [
            "string",
            "null"
          ],
          "enum": [
            null,
            "clean-release",
            "stale-owner-recovery",
            "changed-boot-recovery"
          ]
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "relinquished_at_utc": {
                "type": "null"
              }
            }
          },
          "then": {
            "properties": {
              "relinquish_kind": {
                "type": "null"
              }
            }
          },
          "else": {
            "properties": {
              "relinquish_kind": {
                "type": "string"
              }
            }
          }
        }
      ]
    }
  },
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "attempt_id",
    "sha",
    "form",
    "creation_boot_id",
    "recovery_boot_id",
    "state",
    "stage",
    "completed_stages",
    "predecessor_evidence_sha256",
    "pre_f4_sha256",
    "final_gate_staging_claim_id",
    "final_gate_staging_state",
    "staged_f4_sha256",
    "staged_outcome_sha256",
    "controller_lease_path",
    "controller_lease_identity",
    "controller_lease_state",
    "controller_owners",
    "child_argv_sha256",
    "started_at_utc",
    "child_pid",
    "child_pgid",
    "child_start_ticks",
    "child_barrier_released",
    "termination_kind",
    "boot_disappearance_sha256",
    "wait_exit_code",
    "wait_signal",
    "timed_out",
    "typed_outcome_sha256",
    "cleanup_verified",
    "updated_at_utc"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "attempt_id": {
      "$ref": "#/$defs/uuid"
    },
    "sha": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "form": {
      "enum": [
        "inputs",
        "scope-pre",
        "pre-f4",
        "final"
      ]
    },
    "creation_boot_id": {
      "$ref": "#/$defs/uuid"
    },
    "recovery_boot_id": {
      "oneOf": [
        {
          "$ref": "#/$defs/uuid"
        },
        {
          "type": "null"
        }
      ]
    },
    "state": {
      "enum": [
        "prepared",
        "child-barrier",
        "child-running",
        "child-terminal",
        "between-stages",
        "recovering",
        "failure-ready",
        "success"
      ]
    },
    "stage": {
      "type": [
        "string",
        "null"
      ],
      "enum": [
        null,
        "f4-decision",
        "final-freeze"
      ]
    },
    "completed_stages": {
      "type": "array",
      "maxItems": 2,
      "prefixItems": [
        {
          "const": "f4-decision"
        },
        {
          "const": "final-freeze"
        }
      ],
      "items": false
    },
    "predecessor_evidence_sha256": {
      "$ref": "#/$defs/nullableSha256"
    },
    "pre_f4_sha256": {
      "$ref": "#/$defs/nullableSha256"
    },
    "final_gate_staging_claim_id": {
      "oneOf": [
        {
          "$ref": "#/$defs/uuid"
        },
        {
          "type": "null"
        }
      ]
    },
    "final_gate_staging_state": {
      "type": [
        "string",
        "null"
      ],
      "enum": [
        null,
        "unreserved",
        "reserved",
        "active",
        "released"
      ]
    },
    "staged_f4_sha256": {
      "$ref": "#/$defs/nullableSha256"
    },
    "staged_outcome_sha256": {
      "$ref": "#/$defs/nullableSha256"
    },
    "controller_lease_path": {
      "type": "string",
      "pattern": "^/[^\\u0000\\r\\n]*/final-wave-controller\\.lease$"
    },
    "controller_lease_identity": {
      "$ref": "#/$defs/leaseIdentity"
    },
    "controller_lease_state": {
      "enum": [
        "held",
        "released"
      ]
    },
    "controller_owners": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/controllerOwner"
      }
    },
    "child_argv_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "started_at_utc": {
      "$ref": "#/$defs/nullableTimestamp"
    },
    "child_pid": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 1
    },
    "child_pgid": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 1
    },
    "child_start_ticks": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 1
    },
    "child_barrier_released": {
      "type": [
        "boolean",
        "null"
      ]
    },
    "termination_kind": {
      "type": [
        "string",
        "null"
      ],
      "enum": [
        null,
        "wait-result",
        "boot-disappearance"
      ]
    },
    "boot_disappearance_sha256": {
      "$ref": "#/$defs/nullableSha256"
    },
    "wait_exit_code": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 0,
      "maximum": 255
    },
    "wait_signal": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 1
    },
    "timed_out": {
      "type": "boolean"
    },
    "typed_outcome_sha256": {
      "$ref": "#/$defs/nullableSha256"
    },
    "cleanup_verified": {
      "type": "boolean"
    },
    "updated_at_utc": {
      "$ref": "#/$defs/timestamp"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "form": {
            "enum": [
              "inputs",
              "scope-pre"
            ]
          }
        }
      },
      "then": {
        "properties": {
          "predecessor_evidence_sha256": {
            "type": "null"
          },
          "pre_f4_sha256": {
            "type": "null"
          }
        }
      },
      "else": {
        "if": {
          "properties": {
            "form": {
              "const": "pre-f4"
            }
          }
        },
        "then": {
          "properties": {
            "predecessor_evidence_sha256": {
              "$ref": "#/$defs/sha256"
            },
            "pre_f4_sha256": {
              "type": "null"
            }
          }
        },
        "else": {
          "properties": {
            "predecessor_evidence_sha256": {
              "$ref": "#/$defs/sha256"
            },
            "pre_f4_sha256": {
              "$ref": "#/$defs/sha256"
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "form": {
            "const": "final"
          },
          "stage": {
            "const": "f4-decision"
          }
        }
      },
      "then": {
        "properties": {
          "completed_stages": {
            "maxItems": 0
          },
          "staged_f4_sha256": {
            "type": "null"
          },
          "staged_outcome_sha256": {
            "type": "null"
          }
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "state": {
                  "const": "failure-ready"
                }
              }
            },
            "then": {
              "properties": {
                "final_gate_staging_state": {
                  "enum": [
                    "unreserved",
                    "released"
                  ]
                }
              }
            },
            "else": {
              "properties": {
                "final_gate_staging_state": {
                  "enum": [
                    "unreserved",
                    "reserved",
                    "active"
                  ]
                }
              }
            }
          }
        ]
      }
    },
    {
      "if": {
        "properties": {
          "form": {
            "const": "final"
          },
          "stage": {
            "const": "final-freeze"
          }
        }
      },
      "then": {
        "properties": {
          "completed_stages": {
            "minItems": 1
          },
          "final_gate_staging_state": {
            "const": "released"
          },
          "staged_f4_sha256": {
            "$ref": "#/$defs/sha256"
          },
          "staged_outcome_sha256": {
            "$ref": "#/$defs/sha256"
          }
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "state": {
                  "const": "success"
                }
              }
            },
            "else": {
              "properties": {
                "completed_stages": {
                  "maxItems": 1
                }
              }
            }
          }
        ]
      }
    },
    {
      "if": {
        "properties": {
          "form": {
            "const": "final"
          },
          "stage": {
            "const": "f4-decision"
          },
          "state": {
            "enum": [
              "child-barrier",
              "child-running",
              "child-terminal"
            ]
          }
        }
      },
      "then": {
        "properties": {
          "final_gate_staging_state": {
            "const": "active"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "form": {
            "const": "final"
          },
          "state": {
            "const": "success"
          }
        }
      },
      "then": {
        "properties": {
          "completed_stages": {
            "minItems": 2,
            "maxItems": 2
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "form": {
            "enum": [
              "inputs",
              "scope-pre",
              "pre-f4"
            ]
          }
        }
      },
      "then": {
        "properties": {
          "stage": {
            "type": "null"
          },
          "completed_stages": {
            "maxItems": 0
          },
          "final_gate_staging_claim_id": {
            "type": "null"
          },
          "final_gate_staging_state": {
            "type": "null"
          },
          "staged_f4_sha256": {
            "type": "null"
          },
          "staged_outcome_sha256": {
            "type": "null"
          }
        }
      },
      "else": {
        "properties": {
          "stage": {
            "enum": [
              "f4-decision",
              "final-freeze"
            ]
          },
          "final_gate_staging_claim_id": {
            "$ref": "#/$defs/uuid"
          },
          "final_gate_staging_state": {
            "enum": [
              "unreserved",
              "reserved",
              "active",
              "released"
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "state": {
            "enum": [
              "prepared",
              "between-stages"
            ]
          }
        }
      },
      "then": {
        "properties": {
          "controller_lease_state": {
            "const": "held"
          },
          "started_at_utc": {
            "type": "null"
          },
          "child_pid": {
            "type": "null"
          },
          "child_pgid": {
            "type": "null"
          },
          "child_start_ticks": {
            "type": "null"
          },
          "child_barrier_released": {
            "type": "null"
          },
          "termination_kind": {
            "type": "null"
          },
          "boot_disappearance_sha256": {
            "type": "null"
          },
          "wait_exit_code": {
            "type": "null"
          },
          "wait_signal": {
            "type": "null"
          },
          "timed_out": {
            "const": false
          },
          "typed_outcome_sha256": {
            "type": "null"
          },
          "cleanup_verified": {
            "const": false
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "state": {
            "const": "child-terminal"
          }
        }
      },
      "then": {
        "properties": {
          "started_at_utc": {
            "$ref": "#/$defs/timestamp"
          },
          "child_pid": {
            "type": "integer"
          },
          "child_pgid": {
            "type": "integer"
          },
          "child_start_ticks": {
            "type": "integer"
          },
          "child_barrier_released": {
            "const": true
          },
          "termination_kind": {
            "const": "wait-result"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "state": {
            "enum": [
              "child-barrier",
              "child-running",
              "child-terminal"
            ]
          }
        }
      },
      "then": {
        "properties": {
          "started_at_utc": {
            "$ref": "#/$defs/timestamp"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "state": {
            "const": "child-barrier"
          }
        }
      },
      "then": {
        "properties": {
          "controller_lease_state": {
            "const": "held"
          },
          "child_pid": {
            "type": "integer"
          },
          "child_pgid": {
            "type": "integer"
          },
          "child_start_ticks": {
            "type": "integer"
          },
          "child_barrier_released": {
            "const": false
          },
          "termination_kind": {
            "type": "null"
          },
          "wait_exit_code": {
            "type": "null"
          },
          "wait_signal": {
            "type": "null"
          },
          "typed_outcome_sha256": {
            "type": "null"
          },
          "cleanup_verified": {
            "const": false
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "state": {
            "const": "child-running"
          }
        }
      },
      "then": {
        "properties": {
          "controller_lease_state": {
            "const": "held"
          },
          "child_pid": {
            "type": "integer"
          },
          "child_pgid": {
            "type": "integer"
          },
          "child_start_ticks": {
            "type": "integer"
          },
          "child_barrier_released": {
            "const": true
          },
          "termination_kind": {
            "type": "null"
          },
          "wait_exit_code": {
            "type": "null"
          },
          "wait_signal": {
            "type": "null"
          },
          "typed_outcome_sha256": {
            "type": "null"
          },
          "cleanup_verified": {
            "const": false
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "state": {
            "enum": [
              "failure-ready",
              "success"
            ]
          }
        }
      },
      "then": {
        "properties": {
          "controller_lease_state": {
            "const": "released"
          },
          "cleanup_verified": {
            "const": true
          }
        }
      },
      "else": {
        "properties": {
          "controller_lease_state": {
            "const": "held"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "state": {
            "const": "success"
          }
        }
      },
      "then": {
        "properties": {
          "started_at_utc": {
            "$ref": "#/$defs/timestamp"
          },
          "child_pid": {
            "type": "integer"
          },
          "child_pgid": {
            "type": "integer"
          },
          "child_start_ticks": {
            "type": "integer"
          },
          "child_barrier_released": {
            "const": true
          },
          "termination_kind": {
            "const": "wait-result"
          },
          "boot_disappearance_sha256": {
            "type": "null"
          },
          "wait_exit_code": {
            "const": 0
          },
          "wait_signal": {
            "type": "null"
          },
          "timed_out": {
            "const": false
          },
          "typed_outcome_sha256": {
            "$ref": "#/$defs/sha256"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "termination_kind": {
            "const": "boot-disappearance"
          }
        }
      },
      "then": {
        "properties": {
          "recovery_boot_id": {
            "$ref": "#/$defs/uuid"
          },
          "boot_disappearance_sha256": {
            "$ref": "#/$defs/sha256"
          },
          "wait_exit_code": {
            "type": "null"
          },
          "wait_signal": {
            "type": "null"
          },
          "timed_out": {
            "const": false
          },
          "typed_outcome_sha256": {
            "type": "null"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "termination_kind": {
            "const": "wait-result"
          }
        }
      },
      "then": {
        "oneOf": [
          {
            "properties": {
              "wait_exit_code": {
                "type": "integer"
              },
              "wait_signal": {
                "type": "null"
              }
            }
          },
          {
            "properties": {
              "wait_exit_code": {
                "type": "null"
              },
              "wait_signal": {
                "type": "integer"
              }
            }
          }
        ]
      }
    }
  ]
}
